# Copy this file to .env and adjust as needed:
#     cp .env.example .env
#
# docker-compose.yml reads .env automatically. Every variable below also has a
# sane inline default, so `docker compose up -d` works even without a .env file.
# .env is git-ignored — never commit real credentials.

# --- Spring Boot application ---
SERVER_PORT=8080

# --- MongoDB (source of truth) ---
MONGO_PORT=27017
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=documents

# --- OpenSearch (search index) ---
OPENSEARCH_PORT=9200
# Keep -Xms and -Xmx identical; OpenSearch expects a fixed heap.
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# --- OpenSearch Dashboards ---
# Only started with: docker compose --profile tools up -d
DASHBOARDS_PORT=5601

# --- Application wiring (read by Spring Boot, not Compose) ---
# Must match the MongoDB credentials above.
MONGO_URI=mongodb://root:change-me@localhost:27017/documents?authSource=admin
OPENSEARCH_URI=http://localhost:9200
OPENSEARCH_DOCUMENTS_INDEX=documents
OPENSEARCH_AUTO_CREATE_INDEX=true

# Seeds sample-documents.json when the index is empty. Set false to start clean.
SAMPLE_DATA_ENABLED=true

# Serves /swagger-ui.html and /v3/api-docs. Set false in production.
SPRINGDOC_ENABLED=true
