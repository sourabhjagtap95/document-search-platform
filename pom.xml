<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.docsearch</groupId>
    <artifactId>document-search-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>document-search-platform</name>
    <description>Document search platform backed by MongoDB and OpenSearch</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- springdoc 3.x is the Spring Boot 4 / Spring Framework 7 line;
             the 2.x line targets Boot 3 and will not work here. -->
        <springdoc.version>3.0.3</springdoc.version>
        <archunit.version>1.4.2</archunit.version>
        <!-- Spring Boot manages neither search client, so both must be pinned. -->
        <opensearch-java.version>3.5.0</opensearch-java.version>
        <solr.version>9.10.1</solr.version>
        <!-- Must match the Jetty version SolrJ is compiled against; see the dependency
             block below for why this cannot be left to Spring Boot's management. -->
        <jetty-for-solrj.version>10.0.26</jetty-for-solrj.version>
        <!-- Must match the swagger-core version springdoc resolves; see the dependency
             block below for why SolrJ otherwise wins this one. -->
        <swagger-annotations.version>2.2.47</swagger-annotations.version>
    </properties>

    <dependencies>
        <!-- REST layer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Operational endpoints: /actuator/health, /actuator/info -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- OpenAPI 3 spec generation + bundled Swagger UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- MongoDB: source of truth for documents -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Bean Validation: constraints on request payloads -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          Official OpenSearch Java client, used directly rather than through a
          Spring Data module: the later days need the raw Query DSL, aggregation,
          reindex and cluster APIs, and the community Spring Data OpenSearch
          module lags Spring Boot releases.
        -->
        <dependency>
            <groupId>org.opensearch.client</groupId>
            <artifactId>opensearch-java</artifactId>
            <version>${opensearch-java.version}</version>
        </dependency>

        <!--
          Apache Solr, the second search backend. SolrJ talks to SolrCloud through
          ZooKeeper rather than to a fixed node, so it follows leader elections and
          shard moves without configuration changes.
        -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj</artifactId>
            <version>${solr.version}</version>
        </dependency>
        <!--
          Separate module since Solr 9: solr-solrj carries CloudSolrClient, but the
          ZooKeeper-backed ClusterStateProvider it needs lives here. Without it,
          building a client from a zkHost fails at runtime, not at compile time.
        -->
        <dependency>
            <groupId>org.apache.solr</groupId>
            <artifactId>solr-solrj-zookeeper</artifactId>
            <version>${solr.version}</version>
        </dependency>

        <!--
          Jetty pinned to the version SolrJ is built against.

          SolrJ's HTTP/2 client needs Jetty 10, and Spring Boot's dependency management
          raises org.eclipse.jetty:* to 12 — while leaving org.eclipse.jetty.http2:* at 10,
          because that group no longer exists in 12. The result is a mixed classpath that
          compiles and then fails at runtime with
          NoClassDefFoundError: org/eclipse/jetty/client/util/InputStreamResponseListener,
          since Jetty 12 flattened the util subpackage.

          Safe to pin here because this application serves HTTP with Tomcat; Jetty is only
          ever used as SolrJ's outbound client. Revisit when SolrJ moves to Jetty 12.
        -->
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-client</artifactId>
            <version>${jetty-for-solrj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-http</artifactId>
            <version>${jetty-for-solrj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-io</artifactId>
            <version>${jetty-for-solrj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-util</artifactId>
            <version>${jetty-for-solrj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-alpn-client</artifactId>
            <version>${jetty-for-solrj.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jetty</groupId>
            <artifactId>jetty-alpn-java-client</artifactId>
            <version>${jetty-for-solrj.version}</version>
        </dependency>

        <!--
          Swagger annotations raised to the version springdoc's swagger-core expects.

          Same shape of problem as the Jetty pin above, in the other direction. springdoc
          pulls swagger-core-jakarta 2.2.47, which calls Schema.$dynamicRef() — a method
          added to the annotation in 2.2.31. SolrJ also depends on
          swagger-annotations-jakarta, at 2.2.22, and sits one level closer to this pom, so
          Maven's nearest-wins resolution hands the whole classpath the older annotation.
          Nothing fails to compile; /v3/api-docs returns 500 at runtime with
          NoSuchMethodError: Schema.$dynamicRef().

          Declared directly so this pom is the nearest definition. Safe because the
          annotations are additive and SolrJ only reads them to describe its own v2 API.
        -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>${swagger-annotations.version}</version>
        </dependency>

        <!-- JUnit 5, Mockito, AssertJ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Spring Boot 4 split the test slices out of spring-boot-starter-test into
          per-technology modules. @WebMvcTest + MockMvc now live here.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Executable architecture rules; see ArchitectureRulesTest -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- Writes META-INF/build-info.properties so /actuator/info
                             reports version, build time and artifact coordinates. -->
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
